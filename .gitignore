# Fritzian Volumetric Indexing - .gitignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Node.js / JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log*
dist/
build/
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Rust
target/
Cargo.lock
**/*.rs.bk

# C/C++
*.o
*.obj
*.exe
*.out
*.so
*.dll
*.dylib
*.a
*.lib

# Java
*.class
*.jar
*.war
*.ear

# Build outputs
out/
bin/
obj/
*.log

# Test outputs
test-results/
coverage/
*.test
*.spec

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup

# Generated FVI files (for testing)
# Uncomment if you don't want to commit test files
# test/*.csv
# examples/generated/*.csv

# Documentation builds
docs/_build/
site/

# Environment variables
.env
.env.local
.env.*.local

# Archive files
*.zip
*.tar.gz
*.rar
*.7z

# Large binary files
*.bin
*.dat

# Profiling and benchmarking
*.prof
benchmark-results/

# CI/CD
.github/workflows/*.log

# macOS
.AppleDouble
.LSOverride

# Windows
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Dependency directories
jspm_packages/
bower_components/

# Optional: Keep example FVI files
!examples/*.csv
!examples/surfaces/*.csv

# Lock files (optional - some prefer to commit these)
# Uncomment to ignore lock files
# package-lock.json
# yarn.lock
# Cargo.lock
# Pipfile.lock
